<launch>
  <arg name="params_file" default="$(find-pkg-share geometric_controller)/config/controller.yaml"/>
  <arg name="trajName" default="figure8_horizontal"/>
  <arg name="omega_value" default="0.5"/>
  <arg name="auto_start" default="true"/>
  <arg name="takeoff_before_trajectory" default="true"/>
  <arg name="use_sim_time" default="false"/>
  <arg name="launch_rviz" default="true"/>
  <arg name="launch_tuning_panel" default="true"/>
  <arg name="rviz_config" default="$(find-pkg-share geometric_controller)/rviz/geometric_controller.rviz"/>

  <node pkg="geometric_controller"
        exec="trajectory_offboard_node"
        name="trajectory_offboard_node"
        output="screen">
    <param from="$(var params_file)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <param name="trajName" value="$(var trajName)"/>
    <param name="omega_value" value="$(var omega_value)"/>
    <param name="offboard.auto_start" value="$(var auto_start)"/>
    <param name="offboard.takeoff_before_trajectory" value="$(var takeoff_before_trajectory)"/>
  </node>

  <node if="$(var launch_rviz)"
        pkg="rviz2"
        exec="rviz2"
        name="rviz2"
        output="screen"
        args="-d $(var rviz_config)"/>

  <node if="$(var launch_tuning_panel)"
        pkg="geometric_controller"
        exec="trajectory_control_panel"
        name="trajectory_control_panel"
        output="screen">
    <param name="target_node" value="/trajectory_offboard_node"/>
  </node>
</launch>
